{
  "name": "outreachos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@outreachos/api",
    "dev:web": "turbo run dev --filter=@outreachos/web",
    "dev:workers": "turbo run dev --filter=@outreachos/workers",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate --filter=@outreachos/db",
    "db:push": "turbo run db:push --filter=@outreachos/db",
    "db:migrate": "turbo run db:migrate --filter=@outreachos/db",
    "db:studio": "pnpm --filter @outreachos/db exec prisma studio",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
