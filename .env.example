# ============================================
# OutreachOS Environment Configuration
# Copy this file to .env and fill in the values
# ============================================

# Database
DATABASE_URL="postgresql://outreachos:outreachos_dev@localhost:5432/outreachos?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# ClickHouse
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_DB="outreachos"

# Auth
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-me-to-another-random-64-char-string"
BCRYPT_ROUNDS=12

# Encryption (for mailbox credentials)
ENCRYPTION_MASTER_KEY="change-me-to-a-32-byte-hex-key-0123456789abcdef0123456789abcdef"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"

# Microsoft OAuth
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3001/auth/microsoft/callback"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_GROWTH_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""

# Anthropic (AI Agents)
ANTHROPIC_API_KEY=""

# AI Service
AI_SERVICE_URL="http://localhost:8000"

# App
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
API_PORT=3001
NODE_ENV="development"

# Email (for testing)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
